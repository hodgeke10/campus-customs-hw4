# Copy this file to .env (in this hw4/ folder) and fill in your own value.
# The backend reads PORTKEY_API_KEY from here; it is never committed.

# Portkey API key (routes model calls through the Portkey gateway to OpenAI).
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional — defaults to https://api.portkey.ai/v1 if unset.
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
